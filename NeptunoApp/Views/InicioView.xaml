<UserControl x:Class="NeptunoApp.Views.InicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NeptunoApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InicioViewModel}"
             d:DesignHeight="520" d:DesignWidth="860">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Categorías" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="28"
                Visibility="{Binding SlideActual, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="◀" Command="{Binding AnteriorCommand}"
                        Width="48" Height="48" FontSize="18" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Margin="28,8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SlideActual.Categoria.NombreCategoria}"
                               FontSize="32" FontWeight="Bold" Foreground="#1F7A8C" />
                    <TextBlock Text="{Binding SlideActual.Categoria.Descripcion}"
                               FontSize="16" TextWrapping="Wrap" Margin="0,10,0,16" />
                    <TextBlock FontSize="14">
                        <Run Text="Productos en esta categoría: " />
                        <Run Text="{Binding SlideActual.CantidadProductos, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <TextBlock Text="{Binding SlideActual.ProductosDestacados}"
                               TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#5B6B7A" />
                    <TextBlock Text="{Binding Indicador}" Margin="0,20,0,0" FontWeight="SemiBold" />
                </StackPanel>

                <Button Grid.Column="2" Content="▶" Command="{Binding SiguienteCommand}"
                        Width="48" Height="48" FontSize="18" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding MensajeEstado}" Margin="0,12,0,0" Foreground="#5B6B7A" />
    </Grid>
</UserControl>
