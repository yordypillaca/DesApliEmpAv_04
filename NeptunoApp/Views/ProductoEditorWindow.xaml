<Window x:Class="NeptunoApp.Views.ProductoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NeptunoApp.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ProductoEditorViewModel}"
        Title="{Binding Titulo}" Height="520" Width="520"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Titulo}"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Text="Nombre:" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NombreProducto, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2" Text="Categoría:" VerticalAlignment="Center" />
        <ComboBox Grid.Row="2" Grid.Column="1"
                  ItemsSource="{Binding Categorias}"
                  SelectedItem="{Binding CategoriaSeleccionada}"
                  DisplayMemberPath="NombreCategoria" />

        <TextBlock Grid.Row="3" Text="Proveedor:" VerticalAlignment="Center" />
        <ComboBox Grid.Row="3" Grid.Column="1"
                  ItemsSource="{Binding Proveedores}"
                  SelectedItem="{Binding ProveedorSeleccionado}"
                  DisplayMemberPath="CompaniaNombre" />

        <TextBlock Grid.Row="4" Text="Presentación:" VerticalAlignment="Center" />
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CantidadPorUnidad, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="5" Text="Precio:" VerticalAlignment="Center" />
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding PrecioUnidad, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="6" Text="Stock:" VerticalAlignment="Center" />
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding UnidadesEnExistencia, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="7" Text="En pedido:" VerticalAlignment="Center" />
        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding UnidadesEnPedido, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="8" Text="Reorden:" VerticalAlignment="Center" />
        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding NivelDeReorden, UpdateSourceTrigger=PropertyChanged}" />

        <CheckBox Grid.Row="9" Grid.Column="1" Content="Descontinuado"
                  IsChecked="{Binding Descontinuado}" Margin="0,0,0,12" />

        <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal">
            <Button Content="Guardar" Command="{Binding AceptarCommand}" IsDefault="True" />
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" IsCancel="True" />
        </StackPanel>

        <TextBlock Grid.Row="11" Grid.ColumnSpan="2" Text="{Binding MensajeEstado}"
                   Foreground="Firebrick" Margin="0,10,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
