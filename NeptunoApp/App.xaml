<Application x:Class="NeptunoApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NeptunoApp.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        <SolidColorBrush x:Key="BrushFondo" Color="#F4F6F8" />
        <SolidColorBrush x:Key="BrushSidebar" Color="#1B3A4B" />
        <SolidColorBrush x:Key="BrushAcento" Color="#1F7A8C" />
        <SolidColorBrush x:Key="BrushTexto" Color="#1B2838" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Background" Value="{StaticResource BrushAcento}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>
    </Application.Resources>
</Application>
